{
  "name": "ayush-homepage",
  "version": "1.0.0",
  "description": "Personal homepage for Ayush Nimeshkumar Patel, built with vanilla HTML5, CSS3 and ES6 modules. Features an interactive skill constellation.",
  "type": "module",
  "main": "js/main.js",
  "homepage": "https://ayushp2207.github.io/ayush-homepage/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushp2207/ayush-homepage.git"
  },
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "test:routing": "node docs/routing-test.mjs"
  },
  "keywords": [
    "portfolio",
    "homepage",
    "es6-modules",
    "vanilla-js",
    "bootstrap",
    "cs5610"
  ],
  "author": "Ayush Nimeshkumar Patel <ayushnpatelworks@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.11.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3"
  }
}
